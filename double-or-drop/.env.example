NEXT_PUBLIC_HUB_URL=http://localhost:3001
MUSICAL_DAILY_AUTH_ORIGIN=http://localhost:3001
MUSICAL_DAILY_APP_ORIGIN=http://localhost:3005
# Use the same server-only secret as the hub and all other games.
MUSICAL_DAILY_SERVICE_SECRET=
# Vercel: a dedicated managed database (keep it separate from Encore's game tables).
# DOUBLE_DROP_TURSO_DATABASE_URL=libsql://your-double-drop-database.turso.io
# DOUBLE_DROP_TURSO_AUTH_TOKEN=
# Provider cache may share Encore's managed database, or have a dedicated database.
# ENCORE_TURSO_DATABASE_URL=libsql://your-encore-database.turso.io
# ENCORE_TURSO_AUTH_TOKEN=
# MUSIC_CACHE_TURSO_DATABASE_URL=libsql://your-optional-provider-cache.turso.io
# MUSIC_CACHE_TURSO_AUTH_TOKEN=
# Local development only: writable SQLite paths. Never use ephemeral Vercel disk.
# DOUBLE_DROP_DB_PATH=/persistent/double-or-drop.sqlite
# DOUBLE_DROP_CATALOG_DIR=/persistent/double-drop-catalog
# MUSIC_PROVIDER_CACHE_PATH=/persistent/music-provider.sqlite
# Runtime artist metadata budget; immutable packs referenced by saved runs are protected.
# DOUBLE_DROP_CATALOG_STORAGE_BUDGET_BYTES=268435456
