NEXT_PUBLIC_BLACKJACK_URL=http://localhost:3000
NEXT_PUBLIC_TEMPO_TRAP_URL=http://localhost:3002
NEXT_PUBLIC_ENCORE_URL=http://localhost:3004
NEXT_PUBLIC_DOUBLE_DROP_URL=http://localhost:3005

# Central Google sign-in; never prefix these secrets with NEXT_PUBLIC_.
# Register exactly http://localhost:3001/api/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32+ random characters and use the same value in every app server.
MUSICAL_DAILY_SERVICE_SECRET=
MUSICAL_DAILY_AUTH_ORIGIN=http://localhost:3001
MUSICAL_DAILY_BLACKJACK_ORIGIN=http://localhost:3000
MUSICAL_DAILY_TEMPO_ORIGIN=http://localhost:3002
MUSICAL_DAILY_ENCORE_ORIGIN=http://localhost:3004
MUSICAL_DAILY_DOUBLE_DROP_ORIGIN=http://localhost:3005
# Persistent private disk, outside public/; back up this database.
ACCOUNTS_DB_PATH=data/accounts.sqlite
