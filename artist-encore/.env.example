# Development works with public previews. Production stays disabled until approved audio access is configured.
ENCORE_AUDIO_ENABLED=false
NEXT_PUBLIC_HUB_URL=http://localhost:3001
# ENCORE_DB_PATH=/persistent/encore.sqlite
# ENCORE_CATALOG_CACHE_PATH=/persistent/encore-catalog.sqlite
# Optional shared provider cache used by Encore and Double or Drop.
# MUSIC_PROVIDER_CACHE_PATH=/persistent/music-provider.sqlite
# Shared account service; use the same server-only secret in the hub and all games.
MUSICAL_DAILY_AUTH_ORIGIN=http://localhost:3001
MUSICAL_DAILY_APP_ORIGIN=http://localhost:3004
MUSICAL_DAILY_SERVICE_SECRET=
