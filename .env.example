# Server-only managed storage. Vercel's Turso integration supplies these values.
ENCORE_TURSO_DATABASE_URL=
ENCORE_TURSO_AUTH_TOKEN=
DOUBLE_DROP_TURSO_DATABASE_URL=
DOUBLE_DROP_TURSO_AUTH_TOKEN=
# Central accounts, sessions, scores and cross-device progress. Use a separate database.
ACCOUNTS_TURSO_DATABASE_URL=
ACCOUNTS_TURSO_AUTH_TOKEN=
# Services default to guest mode. Set exactly 0 only after the account settings below
# and the managed accounts database are configured, then rebuild all five services.
NEXT_PUBLIC_GUEST_ONLY=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MUSICAL_DAILY_SERVICE_SECRET=
# Bare production HTTPS origin, with no game path. Replace for a custom domain.
MUSICAL_DAILY_AUTH_ORIGIN=https://musical-daily.vercel.app
MUSICAL_DAILY_APP_ORIGIN=https://musical-daily.vercel.app
# MUSICAL_DAILY_ACCOUNT_SERVICE_URL is injected by Vercel bindings; do not set it.
# A stable, randomly generated value of at least 32 characters.
TEMPO_SESSION_SECRET=
# Enables Encore's existing audio game in the deployed guest preview.
ENCORE_AUDIO_ENABLED=true
# Optional dedicated metadata store; otherwise both games share Encore's cache.
# MUSIC_CACHE_TURSO_DATABASE_URL=
# MUSIC_CACHE_TURSO_AUTH_TOKEN=
